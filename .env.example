# Copy to .env (git-ignored) and fill in. Every value has a safe local default.

# Reference date of the case data. Address-proof age and slot dates are computed from this.
TODAY=2026-07-15
# 1 shows demo controls (sample KYC applicants, "move to next step"). Set 0 for anything real.
DEMO_MODE=1

# Back-office passcode, sent as the X-Backoffice-Key header.
BACKOFFICE_KEY=change-me
# Encrypts phone numbers at rest. Generate one with:
#   backend/.venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Advisor LLMs, tried in LLM_ORDER. With no key the advisor runs on its rules parser.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_ORDER=groq,gemini
LLM_TIMEOUT_S=8
